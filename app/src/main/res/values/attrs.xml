<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Background of the app bar, tab strip and drawer header (pink in light mode, a dark surface in dark mode). -->
    <attr name="colorAppBar" format="color" />
    <!-- Content (title, icons, tab labels) drawn on [colorAppBar]. -->
    <attr name="colorOnAppBar" format="color" />

    <!-- The diagonal tag in the top-right corner of covers whose issue is out of date. -->
    <declare-styleable name="CornerRibbonView">
        <attr name="ribbonColor" format="color" />
        <attr name="ribbonTextColor" format="color" />
        <attr name="ribbonTextSize" format="dimension" />
        <attr name="ribbonText" format="string" />
    </declare-styleable>
</resources>
